<% layout("layouts/boilerPlate") %>
    <div class="row">
        <div class="col-8 offset-2">
            <h3>Listing Details</h3>
        </div>
        <div class="card col-6 offset-3 show-card">
            <img src="<%= listing.image %>" class="card-img-top show-img" alt="Listing Image" />
            <div class="card-body">
                <p class="card-text">
                    <strong>Title:</strong>
                    <%= listing.title %><br />
                        <strong>Description:</strong>
                        <%= listing.description %><br />
                            <strong>Price:</strong> ₹
                            <%= listing.price.toLocaleString("en-IN") %><br />
                                <strong>Location:</strong>
                                <%= listing.location %>,
                                    <%= listing.country %>
                </p>
            </div>
        </div>
        <div class="btns">
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-warning text-light col-1 offset-3">Edit</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="d-inline">
                <button class="btn btn-danger offset-4">Delete</button>
            </form>
        </div>
    </div>